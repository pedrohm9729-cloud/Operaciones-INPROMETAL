# =============================================================================
# VARIABLES DE ENTORNO - OPERACIONES INPROMETAL
# =============================================================================
# Copia este archivo a .env y completa los valores reales
# IMPORTANTE: .env está en .gitignore, NUNCA commits este archivo con valores reales

# API KEYS (SENSIBLES - Usar solo en desarrollo local o secretos de CI/CD)
CODA_API_KEY=tu_coda_api_key_aqui
CODA_DOC_ID=tu_coda_document_id_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui

# PUERTO DEL SERVIDOR
PORT=5000

# AMBIENTE (development, staging, production)
ENVIRONMENT=development

# DOMINIO PERMITIDO PARA CORS (separado por comas)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://operaciones.inprometal.com

# CONFIGURACIÓN DE SESIÓN (en segundos)
SESSION_TIMEOUT=1800  # 30 minutos
SESSION_REFRESH_INTERVAL=300  # 5 minutos

# RATE LIMITING (Login)
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW=900  # 15 minutos

# DEBUG MODE (true/false)
DEBUG=false

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=/var/log/operaciones-inprometal/app.log

# =============================================================================
# INSTRUCCIONES PARA CONFIGURAR:
# =============================================================================
# 1. Copia este archivo:
#    cp .env.example .env
#
# 2. Edita .env y rellena los valores reales:
#    CODA_API_KEY, GEMINI_API_KEY, etc.
#
# 3. El servidor leerá automáticamente .env en el startup
#
# 4. NUNCA commits .env a git. Ya está en .gitignore.
#
# 5. Para producción, usa un gestor de secretos:
#    - AWS Secrets Manager
#    - Google Cloud Secret Manager
#    - HashiCorp Vault
#    - Variables de entorno del sistema
# =============================================================================
