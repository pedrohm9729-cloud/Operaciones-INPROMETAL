# =============================================================================
# 🚨 INSTRUCCIONES CRÍTICAS PARA SINCRONIZACIÓN GMAIL
# =============================================================================
# Este archivo DEBE ser copiado a .env y completado antes de que funcione
# la sincronización. SIN .env, el error será:
# "Error de conexión con el script de sincronización"

# PASO 1: Copiar este archivo
cp .env.template .env

# PASO 2: Llenar los valores reales (ver instrucciones abajo)
# PASO 3: Obtener credentials.json de Google Cloud (ver abajo)
# PASO 4: Ejecutar gastos_bancarios.py para generar token.json

# =============================================================================
# CONFIGURACIÓN REQUERIDA PARA SINCRONIZACIÓN
# =============================================================================

# Coda API Key - REQUERIDO para actualizar tablas
# Obtener en: https://coda.io/account/settings#apiTokens
# Copiar el "API token" completo (comienza con "d-")
CODA_API_KEY=tu_coda_api_key_aqui_ejemplo_d-abc123xyz789

# Coda Document ID - REQUERIDO (obtener de la URL)
# Ej: https://coda.io/d/{ESTE_ID}/...
CODA_DOC_ID=vjnLYcbb8p

# Gemini API Key - REQUERIDO para categorización automática
# Obtener en: https://aistudio.google.com/app/apikey
# Clic "Create API Key" → "Create new API key in Google Cloud Project"
GEMINI_API_KEY=tu_gemini_api_key_aqui_ejemplo_AIza...

# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR
# =============================================================================

# Puerto donde corre el servidor Python
PORT=5000

# Ambiente (development, staging, production)
ENVIRONMENT=development

# DEBUG (true/false) - Mostrar errores detallados
DEBUG=false

# =============================================================================
# CONFIGURACIÓN DE SESIÓN
# =============================================================================

# Timeout de sesión en segundos (30 minutos por defecto)
SESSION_TIMEOUT=1800

# Intervalo de refresco de sesión en segundos
SESSION_REFRESH_INTERVAL=300

# =============================================================================
# RATE LIMITING
# =============================================================================

# Máximo intentos de login fallidos
MAX_LOGIN_ATTEMPTS=5

# Ventana de tiempo para rate limiting en segundos (15 minutos)
RATE_LIMIT_WINDOW=900

# =============================================================================
# LOGGING
# =============================================================================

# Nivel de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Ruta de archivo de logs (opcional)
LOG_FILE=/var/log/operaciones-inprometal/app.log

# =============================================================================
# ARCHIVOS ADICIONALES REQUERIDOS
# =============================================================================

# ⚠️ credentials.json - REQUERIDO para autenticación Gmail
# Obtener en:
#   1. Google Cloud Console → https://console.cloud.google.com
#   2. Crear proyecto (si no existe)
#   3. APIs & Services → Credentials
#   4. Create OAuth 2.0 Client ID (tipo: Desktop Application)
#   5. Descargar JSON → guardar como "credentials.json" en raíz del proyecto
#
# Archivo: /home/user/Operaciones-INPROMETAL/credentials.json
# (Este archivo está en .gitignore, NO se sube a GitHub)

# ⚠️ token.json - GENERADO automáticamente por OAuth
# Se crea ejecutando gastos_bancarios.py por primera vez:
#   python3 gastos_bancarios.py
#
# Se abrirá navegador pidiendo autenticación Gmail → autorizar
# Archivo generado: /home/user/Operaciones-INPROMETAL/token.json
# (Este archivo está en .gitignore, NO se sube a GitHub)

# =============================================================================
# CHECKLIST DE IMPLEMENTACIÓN
# =============================================================================

# ✅ Pasos para que funcione la sincronización:
#
# [ ] 1. Crear .env desde .env.template
#        cp .env.template .env
#
# [ ] 2. Editar .env con valores reales
#        nano .env
#        - CODA_API_KEY: Obtener de https://coda.io/account/settings#apiTokens
#        - GEMINI_API_KEY: Obtener de https://aistudio.google.com/app/apikey
#        - CODA_DOC_ID: Dejar default (vjnLYcbb8p) o cambiar si es diferente
#
# [ ] 3. Obtener credentials.json
#        - Google Cloud Console → OAuth Desktop App
#        - Descargar JSON
#        - Guardar como credentials.json en raíz del proyecto
#
# [ ] 4. Generar token.json
#        - Ejecutar: python3 gastos_bancarios.py
#        - Se abre navegador, autorizar acceso a Gmail
#        - Se crea automáticamente token.json
#
# [ ] 5. Reiniciar servidor
#        - Ctrl+C en server.py
#        - python3 server.py
#
# [ ] 6. Probar sincronización
#        - Ir a http://localhost:5000
#        - Clickear "Sincronizar Gmail a Coda"
#        - Debe funcionar SIN errores
#
# [ ] 7. En Hostinger
#        - Subir .env vía SFTP
#        - Subir credentials.json vía SFTP
#        - Subir token.json vía SFTP (O generar allá)
#        - Reiniciar servidor Python
#
# ===== Si falla después de esto, revisar logs =====
#       tail -100 /var/log/operaciones-inprometal/app.log

# =============================================================================
# SOLUCIÓN DE PROBLEMAS
# =============================================================================

# Q: "Error de conexión con el script de sincronización"
# A: Falta .env, credentials.json o token.json
#    Verificar: ls -la .env credentials.json token.json
#    Si faltan, seguir pasos 1-4 arriba

# Q: "CODA_API_KEY no configurada"
# A: .env existe pero CODA_API_KEY está vacío
#    Editar .env y llenar el valor real desde https://coda.io/account/settings#apiTokens

# Q: "GEMINI_API_KEY no configurada"
# A: .env existe pero GEMINI_API_KEY está vacío
#    Editar .env y llenar el valor real desde https://aistudio.google.com/app/apikey

# Q: "credentials.json not found"
# A: Falta obtener Google OAuth credentials
#    Ir a Google Cloud Console → crear OAuth Desktop App → descargar JSON
#    Guardar como credentials.json en raíz del proyecto

# Q: "Token expired"
# A: token.json expiró (15 días sin usar)
#    Solución: Ejecutar gastos_bancarios.py nuevamente para refrescar
#             python3 gastos_bancarios.py

# Q: "Gmail API rate limited"
# A: Se alcanzó el límite de llamadas a Gmail API (1000/día)
#    Esperar 24 horas o aumentar cuota en Google Cloud Console

# Q: En Hostinger: "Token expirado pero no se puede refrescar"
# A: Hostinger es headless (sin navegador)
#    Solución: Generar token.json en máquina local → copiar a Hostinger vía SFTP

# =============================================================================
# CONTACTO Y SOPORTE
# =============================================================================

